digraph case_reasoner_activity {
    rankdir=TB
    newrank=true
    fontname="Helvetica"
    fontsize=12
    splines=polyline
    nodesep=0.6
    ranksep=0.75
    node [fontname="Helvetica" fontsize=11 margin="0.25,0.12"]
    edge [fontname="Helvetica" fontsize=10]

    { rank=source; START }

    START     [shape=oval style=filled fillcolor="#2d2d2d" fontcolor=white label="START"]
    END_EMPTY [shape=oval style=filled fillcolor="#2d2d2d" fontcolor=white label="END"]
    END_OK    [shape=oval style=filled fillcolor="#2d2d2d" fontcolor=white label="END — CaseReasoningResult"]

    entry      [shape=rect style="filled,rounded" fillcolor="#dce8f7"
                label="run_case_reasoning()\ncase_brief + rendered_brief\n+ judge_query + case_id"]
    extract    [shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                label="extract_issues\nidentify distinct legal issues\n[high-tier LLM]"]
    empty_rep  [shape=rect style="filled,rounded" fillcolor="#ffd5d5"
                label="generate_empty_report\nno issues found"]
    aggregate  [shape=rect style="filled,rounded" fillcolor="#dce8f7"
                label="aggregate_issues\ncombine all branch results"]
    consistency[shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                label="check_global_consistency\ndetect cross-issue conflicts\n[high-tier LLM]"]
    reconcile  [shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                label="generate reconciliation paragraphs\n[high-tier LLM]"]
    confidence [shape=rect style="filled,rounded" fillcolor="#dce8f7"
                label="compute_confidence\nper-issue + case-level scores"]
    gen_rep    [shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                label="generate_report\nfinal Arabic legal analysis\n[high-tier LLM]"]
    mongodb    [shape=rect style="filled,rounded" fillcolor="#d5e8d4"
                label="upsert to MongoDB\ncase_reasonings collection"]

    issues_check [shape=diamond style=filled fillcolor="#fff3c7" label="Issues\nidentified?"]
    conflicts    [shape=diamond style=filled fillcolor="#ffecc7" label="Conflicts\ndetected?"]
    db_check     [shape=diamond style=filled fillcolor="#ffecc7" label="save_to_db?"]

    subgraph cluster_issue_fanout {
        label="Parallel Send() — one branch per issue"
        fontname="Helvetica" fontsize=11
        style=dashed color="#666666" bgcolor="#f5f5f5" margin=20

        decomp      [shape=rect style="filled,rounded" fillcolor="#dce8f7"
                     label="decompose_issue\nidentify required legal elements"]
        gen_q       [shape=rect style="filled,rounded" fillcolor="#dce8f7"
                     label="generate_retrieval_queries\nproduce law + fact queries per element"]
        ret_law     [shape=rect style="filled,rounded" fillcolor="#d5e8d4"
                     label="retrieve_law\ncivil_law_rag MCP tool"]
        ret_facts   [shape=rect style="filled,rounded" fillcolor="#d5e8d4"
                     label="retrieve_facts\ncase_doc_rag MCP tool"]
        classify_ev [shape=rect style="filled,rounded" fillcolor="#ffecc7"
                     label="classify_evidence\nper element:\nestablished / not_established\ndisputed / insufficient_evidence"]
        apply_law   [shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                     label="apply_law\nArabic legal reasoning\ncite specific articles\n[high-tier LLM]"]
        counterargs [shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                     label="generate_counterarguments\nplaintiff + defendant analyses\n[high-tier LLM]"]
        val_analysis[shape=rect style="filled,rounded" fillcolor="#e8d5f5"
                     label="validate_analysis\ncitation check + logical consistency\n+ completeness\n[medium-tier LLM]"]
        pkg         [shape=rect style="filled,rounded" fillcolor="#d5e8d4"
                     label="package_result\nstructured IssueAnalysis dict"]

        { rank=same; ret_law ret_facts }

        decomp       -> gen_q
        gen_q        -> ret_law
        gen_q        -> ret_facts
        ret_law      -> classify_ev
        ret_facts    -> classify_ev
        classify_ev  -> apply_law
        apply_law    -> counterargs
        counterargs  -> val_analysis
        val_analysis -> pkg
    }

    START        -> entry
    entry        -> extract
    extract      -> issues_check
    issues_check -> empty_rep  [label="NO"  color="#cc0000" fontcolor="#cc0000"]
    empty_rep    -> END_EMPTY
    issues_check -> decomp     [label="YES" color="#336633" fontcolor="#336633"]
    pkg          -> aggregate
    aggregate    -> consistency
    consistency  -> conflicts
    conflicts    -> reconcile  [label="YES" color="#cc6600" fontcolor="#cc6600"]
    reconcile    -> confidence
    conflicts    -> confidence [label="NO"  color="#336633" fontcolor="#336633"]
    confidence   -> gen_rep
    gen_rep      -> db_check
    db_check     -> mongodb    [label="YES" color="#336633" fontcolor="#336633"]
    mongodb      -> END_OK
    db_check     -> END_OK     [label="NO"]
}
